def calculate_variance(list):
  sum = 0
  mean = calculate_mean(list)
  for item in list:
    sum += (item - mean) ** 2
  return sum / len(list)
print(f'The variance of [3, 4, 5, 3, 4, 7, 3] is {calculate_variance([3, 4, 5, 3, 4, 7, 3])}.')
