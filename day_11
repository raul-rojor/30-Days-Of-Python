def calculate_slope(equation):
  start = len(equation) - 1
  slope = False
  slo = ''
  while start > -1:
    if slope:
        if equation[start] == ' ':
          return float(slo)
        slo = equation[start] + slo
    if equation[start] == 'x':
      slope = True
    start -= 1
  return float(slo)
