def list_of_hexa_colors(num):
  possible = ascii_letters[0:6] + digits
  id_list = []
  for i in range(num):
    id = ''
    for j in range(6):
      id = id + possible[randint(0,15)]
    id_list.append('#' + id)
  return id_list
print(f'7 hexa colors: {list_of_hexa_colors(7)}.')
def generate_colors(col, num):
  if col == 'hexa':
    return list_of_hexa_colors(num)   
  elif col == 'rgb':
    colors = []
    for i in range(num):
      colors.append(rgb_color_gen())
    return colors
  else:
    return 'That is not a color type.'
