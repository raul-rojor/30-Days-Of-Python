def user_id_gen_by_user():
  chars = int(input('How many characters in each ID? '))
  ids = int(input('How many IDs? '))
  possible = ascii_letters + digits
  id_list = []
  for i in range(ids):
    id = ''
    for j in range(chars):
      id = id + possible[randint(0,61)]
    id_list.append(id)
  return id_list
print(f'Here are random IDs: {user_id_gen_by_user()}.')
def rgb_color_gen():
  r = randint(0,255)
  g = randint(0,255)
  b = randint(0,255)
  return 'rgb(' + str(r) + ',' + str(g) + ',' + str(b) + ')'
