ages = [19, 22, 19, 24, 20, 25, 26, 24, 25, 24]
ages.sort()
print(ages)
print(f'The youngest age is {ages[0]}.')
print(f'The oldest age is {ages[len(ages) - 1]}.')
m = len(ages) // 2
l = len(ages) // 2 + 1
med = [m]
if len(ages) % 2 == 0:
  m -= 1
med = ages[m:l]
med_total = 0
for age in med:
  med_total += age
print(f'The median age is {med_total / len(med)}.')
total = 0
for age in ages:
  total += age
total = total / len(ages)
print(f'The average age is {total} years.')
print(f'The range of ages is {ages[len(ages) - 1] - ages[0]} years.')
least_av = ages[0] - total
greatest_av = ages[len(ages) - 1] - total
print(f'The least age - average = {abs(least_av)} years and the greatest age - average = {abs(greatest_av)} years.')
