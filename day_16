from datetime import datetime
now = datetime.now()
print(now.strftime('%B %d, %Y, at %H:%M:%S'))
print(now.strftime('%m/%d/%y, %H:%M:%S'))
time = datetime.strptime('5 December, 2019', '%d %B, %Y')
print('That was on', time)
newyear = datetime(year=2027, month=1, day=1)
print('The time until 2027 is', newyear - now)
print('The time since January 1st, 1970 is', now.timestamp())
