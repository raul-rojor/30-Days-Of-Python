def letter_count(list):
  dict = {}
  letter = list[0][0]
  count = 0
  for country in list:
    if country[0] == letter:
      count += 1
    else:
      dict[letter] = count
      count = 0
      letter = country[0]
  dict[letter] = count
  return dict
