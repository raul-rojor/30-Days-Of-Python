clear_sent = re.rep('[%@;]+', '', sentence)
uniques = list(set(re.findall('[a-zA-Z0-9]', clear_sent.lower())))
words = []
while len(words) < 3:
  count = 0
  for word in words:
    if word in uniques:
      uniques.remove(word)
  for word in uniques:
    num = len(re.findall(word, paragraph, r.I))
    if count < num:
      count = num
      words = [word]
