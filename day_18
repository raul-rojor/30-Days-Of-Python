import re
paragraph = '''I love teaching. If you do not love teaching what else can you love. I love Python if you do not love something which can give you all the
capabilities to develop an application what else can you love.'''
unique_list = list(set(re.findall(r'\w+', paragraph.lower())))
count = 0
words = []
for word in unique_list:
  num = len(re.findall(r'\b' + word + r'\b', paragraph, re.I))
  if count < num:
    count = num
    words = [word]
  elif count == num:
    words.append(word)
print(', '.join(words), 'is/are the most frequent word(s) in the paragraph.')
talk = """The position of some particles on the horizontal x-axis are -12, -4, -3 and -1 in the negative direction,
0 at origin, 4 and 8 in the positive direction.
Extract these numbers from this whole text and find the distance between the two furthest particles."""
nums = [int(num) for num in re.findall(r'[+-]?\d*.?\d+', talk)]
nums.sort()
print('The range of the numbers in the sentence is', float(nums[len(nums) - 1]) - float(nums[0]))
