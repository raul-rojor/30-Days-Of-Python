import re
paragraph = 'I love teaching. If you do not love teaching what else can you love. I love Python if you do not love something which can give you all the capabilities to develop an application what else can you love.'
unique_list = list(set(re.findall('[a-zA-Z0-9]', paragraph.lower())))
count = 0
words = []
for word in unique_list:
  num = len(re.findall(word, paragraph, r.I))
  if count < num:
    count = num
    words = [word]
  elif count == num:
    words.append(word)
print(', '.join(words), 'is/are the most frequent word(s) in the paragraph.')
