sentence = '''%I $am@% a %tea@cher%, &and& I lo%#ve %tea@ching%;. There $is nothing; &as& mo@re rewarding as
educa@ting &and& @emp%o@wering peo@ple.
;I found tea@ching m%o@re interesting tha@n any other %jo@bs. %Do@es thi%s mo@tivate yo@u to be a tea@cher!?'''
clear_sent = re.sub('[%@;]+', '', sentence)
uniques = list(set(re.findall(r'\w+', clear_sent.lower())))
words = []
while len(words) < 3:
  count = 0
  temp = []
  for word in words:
    if word in uniques:
      uniques.remove(word)
  for word in uniques:
    num = len(re.findall(r'\b' + word + r'\b', clear_sent, re.I))
    if count < num:
      count = num
      temp = [word]
    elif count == num:
      temp.append(word)
  words = words + temp
print(', '.join(words), 'is/are the most frequent word(s) in the paragraph.')
